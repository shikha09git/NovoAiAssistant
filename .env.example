GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# LLM routing: auto | groq | llama | openai
NOVA_LLM_PROVIDER=auto

# Optional local Llama endpoint (OpenAI-compatible), e.g. Ollama /v1
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_API_KEY=
LLAMA_MODEL=llama3.1:8b
NOVA_BROWSER_PROFILE_DIR=./data/browser_profile
NOVA_GMAIL_AUTO_SEND=0

NOVA_ALWAYS_LISTEN=1
NOVA_ENGLISH_ONLY=1
NOVA_STT_LANGUAGE=en-IN
NOVA_TTS_FORCE_SAPI=0
NOVA_TTS_PREFER_WINDOWS=1
